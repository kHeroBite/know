[Unit]
Description=know-api FastAPI Server
After=network.target mariadb.service

[Service]
User=know
WorkingDirectory=/home/know/apps/know-api
ExecStart=/home/know/apps/know-api/venv/bin/uvicorn main:앱 --host 0.0.0.0 --port 18000 --workers 2
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
